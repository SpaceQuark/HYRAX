[Unit]
Description=HYRAX node agent
After=network-online.target

[Service]
EnvironmentFile=%h/.config/hyrax/agent.env
ExecStart=%h/.local/share/hyrax/venv/bin/hyrax-bask
Restart=always
# Stop or restart only the agent. Its jobs run on and the next agent picks them up from its state file.
KillMode=process
RestartSec=5

[Install]
WantedBy=default.target
